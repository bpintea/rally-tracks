{# Gap-fillers: ES|QL features the benchmark queries above don't exercise.
   Target dataset = hits (anchor source only). #}
{% set gapfiller_queries = [
  { "id": "dissect_url_host",
    "suffix": 'DISSECT URL "%{scheme}://%{host}/%{path}?%{qs}" | STATS c = COUNT(*) BY host | SORT c DESC | LIMIT 10' },
  { "id": "grok_referer",
    "suffix": 'WHERE Referer != "" | GROK Referer "%{NOTSPACE:ref_uri}" | STATS c = COUNT(*) BY ref_uri | LIMIT 10' },
  { "id": "mv_expand_url_parts",
    "suffix": 'EVAL parts = SPLIT(URL, "/") | MV_EXPAND parts | STATS c = COUNT(*) BY parts | SORT c DESC | LIMIT 10' },
  { "id": "inline_stats_max_resolution",
    "suffix": 'INLINE STATS max_resolution = MAX(ResolutionWidth) | WHERE ResolutionWidth == max_resolution | KEEP WatchID, ResolutionWidth, max_resolution | LIMIT 10' }
] %}

{# LOOKUP JOIN: EXTERNAL on the left, indexed `nyc_payment_types` on the right.
   Runs only against NDJSON nyc_taxis sources (N1, N2). #}
{% set lookup_join_queries = [
  { "id": "lookup_join_payment_types",
    "suffix": 'EVAL type = TO_STRING(payment_type) | LOOKUP JOIN nyc_payment_types ON type | STATS revenue = SUM(total_amount) BY name' }
] %}
