{# ---------------------------------------------------------------------------
   Shared data for the esql-datasources track. Import with:
       {% import "_data.j2" as d with context %}
   then access via `d.sources`, `d.benchmark_queries`, `d.subset_ids`,
   `d.gapfiller_queries`, `d.lookup_join_queries`, `d.anchor_source_id`,
   `d.lookup_join_source_ids`.

   Keeping the data here (instead of track.json) lets both operations/*.json
   and challenges/*.json see it: Rally's `rally.collect` macro calls
   `{% include part %}` in an isolated scope that does NOT inherit
   `{% set %}` variables from track.json, but `{% import ... as X with context %}`
   makes the variables reachable as attributes of the imported module.
   --------------------------------------------------------------------------- #}

{% set mirror_region = mirror_region | default("europe-west1") %}
{% set anchor_source_id = anchor_source_id | default("H2") %}
{% set lookup_join_source_ids = ["N1", "N2"] %}

{# Per-op client-side timeout for EXTERNAL queries. A single COUNT(*) over the
   14GB hits.parquet measured ~5 minutes on a local 9.5.0-SNAPSHOT build; the
   90-SUM aggregation and full-scan group-bys are heavier. Default well above
   the worst observed case so a slow run doesn't cause a transport timeout. #}
{% set request_timeout = request_timeout | default(1800) %}

{# --- Source variants (axis A, 8 variants).

   `with` is the EXTERNAL command's WITH-clause map (Jinja-string, inserted
   verbatim between the URI and the leading pipe). Empty string means no WITH.
   Per `esql-datasource-{s3,gcs,azure}` plugins:
     - HTTP backend never needs a WITH clause for public URIs.
     - S3-anon / Azure-anon need `WITH { "auth": "none" }` to opt out of
       the cluster's default credential chain (which on the nightly cluster
       would otherwise pick up the IAM keystore creds intended for the
       internal mirror buckets and fail against the public buckets).
     - S3-IAM / GCS-IAM use the cluster's default IAM instance profile /
       Application Default Credentials — no WITH needed. Override here if
       explicit static credentials are ever required (e.g. during a smoke
       run from outside the provisioned environment).
   --- #}
{% set sources = [
  {
    "id": "H1",
    "uri": "https://clickhouse-public-datasets.s3.amazonaws.com/hits_compatible/hits.parquet",
    "format": "parquet", "codec": "zstd", "backend": "http", "auth": "anonymous", "dataset": "hits",
    "with": ""
  },
  {
    "id": "H2",
    "uri": "s3://clickhouse-public-datasets/hits_compatible/hits.parquet",
    "format": "parquet", "codec": "zstd", "backend": "s3", "auth": "anonymous", "dataset": "hits",
    "with": 'WITH { "auth": "none" }'
  },
  {
    "id": "H3",
    "uri": "s3://clickhouse-public-datasets/hits_compatible/athena_partitioned/hits_*.parquet",
    "format": "parquet", "codec": "zstd", "backend": "s3", "auth": "anonymous", "dataset": "hits",
    "with": 'WITH { "auth": "none" }'
